# ---- secrets ---------------------------------------------------------------
# Device credentials are written here in plaintext once a server exists. A
# secret committed once is compromised permanently, however fast the follow-up
# commit is.
server/.state.json
*.pem
*.key

# ---- credentials -----------------------------------------------------------
.env
**/.env
!**/.env.example

# ---- build output ----------------------------------------------------------
# An ESP-IDF build tree is well over a hundred megabytes of object files that
# are reproducible from source in one command.
firmware/harness/build/
firmware/*/build/

# Regenerated by the build from sdkconfig.defaults; keeping it would put a
# second, stale copy of every decision in the tree.
firmware/harness/sdkconfig.old

# Vendored dependencies, restored by the component manager from the lockfile.
firmware/harness/managed_components/

# Published images and their manifest, written by tools/package.sh. Generated
# from committed source by one command, and rewritten on every build — keeping
# them would put a few hundred kilobytes of binary into the history for every
# firmware change, to save a step that is already a script.
firmware/dist/

# ---- everything else -------------------------------------------------------
# Bytecode from tools/tests. Written on import, never edited, and specific to
# whichever Python happened to run it.
__pycache__/
*.pyc

node_modules/
.DS_Store
Thumbs.db
*.log

# ============================================================================
# Deliberately NOT ignored
# ----------------------------------------------------------------------------
# firmware/harness/sdkconfig
#     Generated, and committed on purpose. It is the record of exactly which
#     options the shipped image was built with, which is the difference between
#     a reproducible build and an approximately reproducible one.
#
# firmware/harness/dependencies.lock
#     Pins component versions. Without it "the same source" builds against
#     whatever the registry is serving today.
# ============================================================================
